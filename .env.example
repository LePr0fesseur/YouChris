# =====================================================
# Configuration — Les Vidéos de Chris
# Copiez ce fichier vers .env et remplissez les valeurs
# =====================================================

# ─── Base de données PostgreSQL ─────────────────────
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/lesvideosdechris

# ─── Authentification NextAuth.js ───────────────────
# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET=
# URL complète de votre site (sans trailing slash)
NEXTAUTH_URL=http://localhost:3000

# ─── YouTube Data API v3 ────────────────────────────
# Clé API depuis Google Cloud Console
YOUTUBE_API_KEY=
# ID de votre chaîne YouTube (commence par UC...)
YOUTUBE_CHANNEL_ID=

# ─── Stripe ─────────────────────────────────────────
# Clés disponibles dans le dashboard Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Secret du webhook (stripe listen --forward-to localhost:3000/api/stripe/webhook)
STRIPE_WEBHOOK_SECRET=whsec_...
# ID du prix d'abonnement mensuel créé dans Stripe
STRIPE_PRICE_ID=price_...

# ─── Stockage objet S3/Cloudflare R2 ────────────────
# Endpoint R2 : https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=https://xxx.r2.cloudflarestorage.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=lesvideosdechris
S3_REGION=auto

# ─── Email (Resend) ──────────────────────────────────
# Clé API depuis resend.com
RESEND_API_KEY=re_...
# Adresse email expéditrice (doit être vérifiée dans Resend)
EMAIL_FROM=noreply@lesvideosdechris.fr

# ─── Application ─────────────────────────────────────
# URL publique complète du site (pour les redirections Stripe)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Email du compte admin créé par le seed
ADMIN_EMAIL=chris@lesvideosdechris.fr
# Prix mensuel affiché (en euros)
PREMIUM_MONTHLY_PRICE=9.99

# ─── Docker (optionnel) ──────────────────────────────
# Mot de passe PostgreSQL pour docker-compose
POSTGRES_PASSWORD=changeme_en_production
